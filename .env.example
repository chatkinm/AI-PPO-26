# =====================================================================
# Конфигурация окружения AI-сервиса ППО (Предпроектного обследования)
# =====================================================================

# 1. Google AI Studio API (Основная LLM для аналитики и генерации ТЗ)
# Получить ключ: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# Модель Google AI Studio (по умолчанию gemma-4-31b-it или gemini-2.5-flash)
# Если модель gemma-4-31b-it еще недоступна в вашем регионе, сервис автоматически
# переключится на gemini-2.5-flash / gemini-1.5-flash для бесперебойной работы
LLM_MODEL=gemma-4-31b-it
LLM_FALLBACK_MODEL=gemini-2.5-flash

# 2. Groq Cloud API (Сверхбыстрая транскрибация аудио через Whisper)
# Получить ключ: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here
GROQ_WHISPER_MODEL=whisper-large-v3

# 3. Figma / FigJam API (Интеграция с досками и прототипами)
# Получить токен: Figma -> Settings -> Security -> Personal access tokens
FIGMA_ACCESS_TOKEN=your_figma_personal_access_token_here

# 4. Настройки сервера
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
DEBUG=True

# 5. Разрешенные CORS источники для фронтенда
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
